{
  "name": "dsh-sandrone",
  "version": "0.1.0",
  "private": true,
  "description": "把「桑多涅」装进 DeepSeek Harness：她的人格预设，加上本机 GPT-SoVITS 克隆语音 —— 每条回复结束后自动用她的声音念出来，可在设置页随时开关。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "assets",
    "preset",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "sandrone",
    "桑多涅",
    "persona",
    "gpt-sovits",
    "tts",
    "voice",
    "preset",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset/sandrone.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT"
}
